# Honeypot-Lab: Vorlage für .env
#
# Nach .env kopieren und jeden Platzhalter ersetzen. .env nie committen,
# Werte nie loggen. Zufallswerte z.B. erzeugen mit: openssl rand -hex 32
#
# Jeder Host bekommt nur die Variablen der für ihn vorgesehenen Abschnitte.
# Der Sensor gilt als kompromittierbar und erhält NIE die Werte aus
# Abschnitt 1 (siehe docs/decisions.md, E-008 und E-009).

# ---------------------------------------------------------------------------
# 1. Nur Hauptserver
# ---------------------------------------------------------------------------

# Passwort des PostgreSQL-Benutzers der Anwendung
POSTGRES_PASSWORD=CHANGE_ME

# Echter API-Key des LLM-Anbieters (Gemini-API), wird nur vom LLM-Gateway
# verwendet. Ein Key eines eigenen Projekts nur fürs Lab mit Billing, sonst
# nutzt Google die Anfragen zum Training (server/README.md, E-045).
LLM_API_KEY=CHANGE_ME

# Schlüssel für HMAC-SHA256 der Quell-IPs (mindestens 32 zufällige Bytes).
# Ein Wechsel macht alte und neue Hashes unvergleichbar.
IP_HMAC_KEY=CHANGE_ME

# Token für den Download der IPinfo-Lite-Datenbank (.mmdb)
IPINFO_TOKEN=CHANGE_ME

# --- LLM-Gateway (Schritt 7.2, E-043, Gemini seit E-045) ---------------------
# Fehlt ein Wert oder ist er ungültig, startet die API trotzdem; nur das
# Gateway antwortet dann mit 503 und nennt beim Start die Namen der fehlenden
# Variablen im Log. Modell, Ausgabegrenze, temperature, Denkmodus und Grenzen
# gehören zu den Behandlungsparametern (docs/method.md 4.5) und bleiben in der
# Laufzeit gleich. Adresse und Preise des Anbieters stehen fest im Code
# (server/app/llm_provider.py), nicht hier.

# Schalter. Nur bei true leitet das Gateway weiter, sonst 503.
LLM_GATEWAY_ENABLED=false

# Feste Modellversion aus der Liste in server/app/llm_provider.py, kein
# "-latest". Gewählt: gemini-3.1-flash-lite (E-045).
LLM_MODEL=gemini-3.1-flash-lite

# Höchstzahl Ausgabe-Tokens je Antwort (1 bis 16384), Denk-Tokens
# eingeschlossen. Groß genug für die längste wörtliche Datei im Prompt (dmesg,
# rund 2.600 Zeichen).
LLM_MAX_TOKENS=2048

# 0 bis 2. Für Gemini 3 empfiehlt Google 1; darunter drohen Schleifen (E-045).
LLM_TEMPERATURE=1

# Denkmodus, so wenig wie das Modell erlaubt: minimal (Flash-Lite), low
# (gemini-3.8-flash). Abschalten geht bei Gemini 3 nicht.
LLM_REASONING_EFFORT=minimal

# Aufeinanderfolgende Nachrichten derselben Rolle mit Zeilenumbruch
# zusammenfassen. Nur auf true, wenn die Probe "verlauf" mit 502 scheitert
# (server/README.md).
LLM_MERGE_TURNS=false

# Zeitlimit je Aufruf beim Anbieter in Sekunden (1 bis 55). Cowrie beendet
# Exec-Sitzungen nach 60 Sekunden.
LLM_TIMEOUT_SECONDS=30

# Budgets in US-Dollar, Kalendermonat und Kalendertag in UTC. Ist eines
# erreicht, antwortet das Gateway mit 503 (Ausfall, nicht 429: das bleibt der
# Minutengrenze vorbehalten). Tagesbudget großzügig, etwa das Doppelte eines
# schlechten Tages: Ein greifendes Tageslimit macht B für den Rest des Tages
# stumm (Ausfallzeit, method.md 8). Ohne Budgets kein Gateway. Herleitung in
# server/README.md.
LLM_BUDGET_MONTH_USD=
LLM_BUDGET_DAY_USD=

# Aufrufe beim Anbieter je 60 Sekunden, alle zusammen (1 bis 10000).
LLM_CALLS_PER_MINUTE=60

# SHA-256 des Persona-Teils im System-Prompt von cowrie-b, 64 Hex-Zeichen.
# Leer: nicht gepinnt, das Gateway loggt den beobachteten Hash (llm-prompt).
LLM_PROMPT_SHA256=

# ---------------------------------------------------------------------------
# 2. Hauptserver und Sensor (gleicher Wert auf beiden Hosts)
# ---------------------------------------------------------------------------

# Bearer-Token, mit dem Vector Events an /ingest sendet
INGEST_TOKEN=CHANGE_ME

# Token, mit dem cowrie-b das LLM-Gateway aufruft (nicht der LLM-API-Key)
LLM_GATEWAY_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# 3. Nur Admin-Rechner (OpenTofu), nie auf Sensor oder Hauptserver
# ---------------------------------------------------------------------------

# HCLOUD_TOKEN: API-Token des Hetzner-Sensor-Projekts. Steht absichtlich nicht
# in .env, sondern wird nur im Terminal als Umgebungsvariable gesetzt
# (siehe infra/README.md).
