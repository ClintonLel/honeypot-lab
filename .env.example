# Honeypot-Lab: Vorlage für .env
#
# Nach .env kopieren und jeden Platzhalter ersetzen. .env nie committen,
# Werte nie loggen. Zufallswerte z.B. erzeugen mit: openssl rand -hex 32
#
# Jeder Host bekommt nur die Variablen der für ihn vorgesehenen Abschnitte.
# Der Sensor gilt als kompromittierbar und erhält NIE die Werte aus
# Abschnitt 1 (siehe docs/decisions.md, E-008 und E-009).

# ---------------------------------------------------------------------------
# 1. Nur Hauptserver
# ---------------------------------------------------------------------------

# Passwort des PostgreSQL-Benutzers der Anwendung
POSTGRES_PASSWORD=CHANGE_ME

# Echter API-Key des LLM-Anbieters, wird nur vom LLM-Gateway verwendet
LLM_API_KEY=CHANGE_ME

# Schlüssel für HMAC-SHA256 der Quell-IPs (mindestens 32 zufällige Bytes).
# Ein Wechsel macht alte und neue Hashes unvergleichbar.
IP_HMAC_KEY=CHANGE_ME

# Token für den Download der IPinfo-Lite-Datenbank (.mmdb)
IPINFO_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# 2. Hauptserver und Sensor (gleicher Wert auf beiden Hosts)
# ---------------------------------------------------------------------------

# Bearer-Token, mit dem Vector Events an /ingest sendet
INGEST_TOKEN=CHANGE_ME

# Token, mit dem cowrie-b das LLM-Gateway aufruft (nicht der LLM-API-Key)
LLM_GATEWAY_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# 3. Nur Admin-Rechner (OpenTofu), nie auf Sensor oder Hauptserver
# ---------------------------------------------------------------------------

# HCLOUD_TOKEN: API-Token des Hetzner-Sensor-Projekts. Steht absichtlich nicht
# in .env, sondern wird nur im Terminal als Umgebungsvariable gesetzt
# (siehe infra/README.md).
