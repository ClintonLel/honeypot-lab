+def input_sha256(text: str) -> str:
+    """SHA-256 of a command line exactly as logged in cowrie.command.input.
+
+    Lets cowrie.llm.response be matched to its command without carrying
+    the command text.
+    """
+    return sha256(text.encode("utf-8", "surrogatepass")).hexdigest()
+
+
+def read_motd() -> bytes:
+    """The message of the day, as the shell backend shows it after login.
+
+    Read from the honeyfs; nothing when it cannot be read, like the shell
+    backend's displayMOTD.
+    """
+    try:
+        path = os.path.join(CowrieConfig.get("honeypot", "contents_path"), "etc", "motd")
+        with open(path, "rb") as motd:
+            return motd.read()
+    except Exception:
+        return b""
