+    ) -> str:
+        """Callback: log the outcome, then hand the response on unchanged."""
+        self.llm_pending = False
+        output_chars = len(strip_markdown(response)) if response else 0
+        self._emit_llm_response(
+            command_index,
+            digest,
+            call.outcome,
+            call.http_status,
+            call.latency_ms,
+            output_chars if call.outcome == "ok" else 0,
+        )
+        return response
+
