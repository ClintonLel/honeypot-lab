+    def _send_with_timeout(self, prompt: list[str]) -> Deferred[tuple[int, bytes]]:
+        """_send_request, failing with LLMTimeout after request_timeout.
+
+        The request is cancelled then; a response arriving later is dropped.
+        """
+        d = self._send_request(prompt)
+        if self.request_timeout <= 0:
+            return d
+
+        result: Deferred[tuple[int, bytes]] = defer.Deferred()
+
+        def expire() -> None:
+            if not result.called:
+                result.errback(failure.Failure(LLMTimeout()))
+                d.cancel()
+
+        timer = reactor.callLater(self.request_timeout, expire)  # type: ignore[attr-defined]
+
+        def settle(value: Any) -> None:
+            if timer.active():
+                timer.cancel()
+            if result.called:
+                return None
+            if isinstance(value, failure.Failure):
+                result.errback(value)
+            else:
+                result.callback(value)
+            return None
+
+        d.addBoth(settle)
+        return result
