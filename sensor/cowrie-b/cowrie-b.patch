+# Outcome of one call, by HTTP status of the endpoint. Everything else,
+# including no response at all, is "error". 429, 503, 502 and 504 follow the
+# conventions of an LLM gateway in front of the provider: a per-minute limit,
+# the gateway or its budget being unavailable, a provider error, a provider
+# timeout.
+OUTCOME_BY_STATUS = {
+    200: "ok",
+    429: "rate_limited",
+    502: "upstream_error",
+    503: "unavailable",
+    504: "timeout",
+}
+
+
+def classify_status(status_code: int) -> str:
+    """The outcome of a call that got an HTTP response with this status."""
+    return OUTCOME_BY_STATUS.get(status_code, "error")
+
+
+class LLMCall:
+    """What one call to the endpoint did, without any prompt or response text.
+
+    Filled in by LLMClient.get_response when passed in, for the
