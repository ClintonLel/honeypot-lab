+    def _next_command_index(self) -> int | None:
+        """Number of the command just logged as cowrie.command.input.
+
+        Counted per connection, starting at 1, shared by all channels of the
+        connection, in the order of the cowrie.command.input events. None
+        for a protocol that was never connected.
+        """
+        if not hasattr(self, "events"):
+            return None
+        transport = self.getProtoTransport()
+        index: int = getattr(transport, "llm_command_index", 0) + 1
+        transport.llm_command_index = index
+        return index
+
+    def _emit_llm_response(
+        self,
+        command_index: int | None,
+        digest: str,
+        outcome: str,
+        http_status: int | None = None,
+        latency_ms: int | None = None,
+        output_chars: int = 0,
+    ) -> None:
+        """Log one cowrie.llm.response for the command with this index.
+
+        No prompt and no response text, only what the call did.
+        """
+        if command_index is None:
+            return
+        self.events.dispatch(
+            "cowrie.llm.response",
+            "LLM response %(outcome)s for command %(command_index)d",
+            command_index=command_index,
+            outcome=outcome,
+            http_status=http_status,
+            latency_ms=latency_ms,
+            output_chars=output_chars,
+            client_gone=self.terminal is None,
+            input_sha256=digest,
+        )
+
+    def _llm_response_logged(
