# Dateien, die Cursor weder indexiert noch einem Modell zeigt.
# Ergänzt .gitignore, ersetzt sie nicht.

# --- Secrets -----------------------------------------------------------------
# .env ohne Schrägstrich greift in jedem Ordner, auch sensor/.env.
.env
.env.*
!.env.example
*.pem
*.key

# --- IPinfo-/GeoIP-Datenbanken -----------------------------------------------
*.mmdb

# --- Datenbank-Dumps und Backups ---------------------------------------------
*.sql
*.sql.gz
*.dump
*.pgdump
*.backup
dumps/
backups/

# --- Honeypot-Rohdaten (Klartext-IPs, Angreifer-Eingaben, Malware) ----------
cowrie.json*
*.log
tty/
downloads/

# --- OpenTofu-State, -Pläne und -Variablen (Sensor-IP, User Data) -----------
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json

# --- Abhängigkeiten und Build ------------------------------------------------
node_modules/
dist/
