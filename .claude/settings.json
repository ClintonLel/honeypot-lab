{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.sql)",
      "Read(**/*.sql.gz)",
      "Read(**/*.dump)",
      "Read(**/*.pgdump)",
      "Read(**/*.backup)",
      "Read(**/dumps/**)",
      "Read(**/backups/**)",
      "Read(**/cowrie.json*)",
      "Read(**/*.log)",
      "Read(**/tty/**)",
      "Read(**/downloads/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfplan)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)"
    ]
  }
}
